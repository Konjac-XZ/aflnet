#!/usr/bin/env python3
"""
afl-convert: Convert AFL seeds to aflnet-replay format

Converts raw binary seeds (as used by afl-fuzz) into the packet-prefixed format
expected by aflnet-replay. Each packet is prefixed with a 4-byte little-endian
size field.

Usage:
    afl-convert <input_file> <output_file> <protocol> [options]

Supported protocols:
    RTSP    - Real Time Streaming Protocol (delimiter: double CRLF)
    FTP     - File Transfer Protocol (delimiter: CRLF)
    MQTT    - Message Queuing Telemetry Transport (variable length encoding)
    TFTP    - Trivial File Transfer Protocol (delimiter: null byte)
    DHCP    - Dynamic Host Configuration Protocol (delimiter: double 0xFF)
    SNTP    - Simple Network Time Protocol (delimiter: null byte)
    DNS     - Domain Name System (fixed 2-byte header)
    raw     - Raw format (no parsing, treat entire file as single packet)

Examples:
    afl-convert seed.bin seed.replay RTSP
    afl-convert ftp_seed.bin ftp.replay FTP
    afl-convert mqtt_seed.bin mqtt.replay MQTT
"""

import struct
import sys
import os
from pathlib import Path


class ProtocolParser:
    """Base class for protocol-specific message extraction."""

    @staticmethod
    def extract_messages(data):
        """Extract messages from raw data. Returns list of byte strings."""
        raise NotImplementedError


class RTSPParser(ProtocolParser):
    """RTSP: Messages delimited by double CRLF (\\r\\n\\r\\n)"""

    @staticmethod
    def extract_messages(data):
        delimiter = b'\r\n\r\n'
        messages = []
        offset = 0

        while offset < len(data):
            # Find next delimiter
            idx = data.find(delimiter, offset)
            if idx == -1:
                # No more delimiters, take rest of data
                if offset < len(data):
                    messages.append(data[offset:])
                break

            # Include delimiter in message
            msg_end = idx + len(delimiter)
            messages.append(data[offset:msg_end])
            offset = msg_end

        return [m for m in messages if m]  # Filter empty messages


class FTPParser(ProtocolParser):
    """FTP: Messages delimited by CRLF (\\r\\n)"""

    @staticmethod
    def extract_messages(data):
        delimiter = b'\r\n'
        messages = []
        offset = 0

        while offset < len(data):
            idx = data.find(delimiter, offset)
            if idx == -1:
                if offset < len(data):
                    messages.append(data[offset:])
                break

            msg_end = idx + len(delimiter)
            messages.append(data[offset:msg_end])
            offset = msg_end

        return [m for m in messages if m]


class MQTTParser(ProtocolParser):
    """MQTT: Variable length encoding in 2-byte header"""

    @staticmethod
    def extract_messages(data):
        messages = []
        offset = 0

        while offset < len(data):
            if offset + 2 > len(data):
                # Not enough data for header
                if offset < len(data):
                    messages.append(data[offset:])
                break

            # MQTT uses variable length encoding
            # First byte is control byte, remaining bits indicate length
            control_byte = data[offset]

            # For simplicity, assume 2-byte header format
            # Real MQTT is more complex, but this handles basic cases
            if offset + 2 <= len(data):
                length_bytes = data[offset + 1]
                msg_len = 2 + length_bytes

                if offset + msg_len <= len(data):
                    messages.append(data[offset:offset + msg_len])
                    offset += msg_len
                else:
                    # Incomplete message, take rest
                    messages.append(data[offset:])
                    break
            else:
                messages.append(data[offset:])
                break

        return [m for m in messages if m]


class TFTPParser(ProtocolParser):
    """TFTP: Messages delimited by null byte (\\x00)"""

    @staticmethod
    def extract_messages(data):
        delimiter = b'\x00'
        messages = []
        offset = 0

        while offset < len(data):
            idx = data.find(delimiter, offset)
            if idx == -1:
                if offset < len(data):
                    messages.append(data[offset:])
                break

            msg_end = idx + len(delimiter)
            messages.append(data[offset:msg_end])
            offset = msg_end

        return [m for m in messages if m]


