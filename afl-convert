    """DHCP: Messages delimited by double 0xFF (\\xff\\xff)"""

    @staticmethod
    def extract_messages(data):
        delimiter = b'\xff\xff'
        messages = []
        offset = 0

        while offset < len(data):
            idx = data.find(delimiter, offset)
            if idx == -1:
                if offset < len(data):
                    messages.append(data[offset:])
